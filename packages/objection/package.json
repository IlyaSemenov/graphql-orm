{
  "name": "objection-graphql-resolver",
  "type": "module",
  "version": "7.6.1",
  "description": "objection.js plugin: resolve GraphQL query using withGraphFetched",
  "author": "Ilya Semenov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/graphql-orm.git",
    "directory": "packages/objection"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "dev": "vite-node --watch playground/readme.sample.ts",
    "build": "tsdown",
    "test": "vitest run && tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "graphql": "^16",
    "objection": "^2 || ^3"
  },
  "dependencies": {
    "graphql-parse-resolve-info": "^4.13.0"
  },
  "devDependencies": {
    "@apollo/server": "^4.7.1",
    "graphql": "^16.6.0",
    "graphql-request": "^6.0.0",
    "graphql-tag": "^2.12.6",
    "knex": "^2.4.2",
    "objection": "^3.0.1",
    "sqlite3": "^5.1.6",
    "tar": "^6.1.15",
    "tsconfig-vite-node": "^1.1.2",
    "vite": "^7.0.5",
    "vite-node": "^3.2.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
